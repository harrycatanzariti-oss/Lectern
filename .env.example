DEEPSEEK_API_KEY=sk-...
# Optional: which DeepSeek model writes courses and marks answers (default deepseek-flash).
# DEEPSEEK_MODEL=deepseek-flash
# Optional: a password for the whole app. Set it whenever the app is on the internet.
# LECTERN_PASSWORD=
# Optional: where the database and uploads live (default ./data).
# LECTERN_DATA=/path/to/data
